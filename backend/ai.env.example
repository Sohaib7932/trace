# Separate opt-in AI configuration example. The application does not load this file.
# AIClientSettings reads TRACE_LLM_* process variables, or an explicitly chosen AI-only
# env file. Do not merge these keys into backend/.env: its existing Settings is strict.
# Approved live provider: Gemini, model gemini-3.5-flash-lite, unbilled Free Tier only.
# Defaults below remain disabled. Use scripts/run-gemini-backend.ps1 or the portable
# python -m scripts.run_gemini launcher with explicit free-tier confirmation.
TRACE_LLM_MODE=disabled
TRACE_LLM_PROVIDER_ID=
TRACE_LLM_GENERATION_MODEL_ID=
TRACE_LLM_CONVERSATIONAL_MODEL_ID=
# A variable NAME only, never the credential itself. The launcher uses GEMINI_API_KEY
# from backend/.env.gemini or an explicitly configured process secret.
TRACE_LLM_CREDENTIAL_ENV_VAR=
# Defaults allow no paid usage. One micro-USD is one millionth of a US dollar.
TRACE_LLM_SPEND_LIMIT_MICROUSD=0
TRACE_LLM_MAX_COST_PER_ATTEMPT_MICROUSD=0
TRACE_LLM_MAX_RETRIES=0
TRACE_LLM_FREE_TIER_PROJECT_CONFIRMED=false
TRACE_LLM_MAX_LIVE_REQUESTS_PER_PROCESS=20
TRACE_LLM_MAX_IN_FLIGHT=4

# The launcher sets this approved activation identity in its process only:
# TRACE_LLM_MODE=gemini_free
# TRACE_LLM_PROVIDER_ID=gemini
# TRACE_LLM_GENERATION_MODEL_ID=gemini-3.5-flash-lite
# TRACE_LLM_CONVERSATIONAL_MODEL_ID=gemini-3.5-flash-lite
# TRACE_LLM_CREDENTIAL_ENV_VAR=GEMINI_API_KEY
# TRACE_LLM_FREE_TIER_PROJECT_CONFIRMED=true
# The launcher uses up to 20 response seconds only when no tighter explicit
# response/total deadline is configured. Tutor/support retain a 30-second HTTP
# deadline; no retry, spending, token or concurrency cap is raised by activation.
