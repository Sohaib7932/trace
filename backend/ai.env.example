# Separate opt-in AI configuration example. The application does not load this file.
# AIClientSettings reads TRACE_LLM_* process variables, or an explicitly chosen AI-only
# env file. Do not merge these keys into backend/.env: its existing Settings is strict.
# No approved live provider exists. Only disabled or explicitly mocked operation is allowed.
TRACE_LLM_MODE=disabled
TRACE_LLM_PROVIDER_ID=
TRACE_LLM_GENERATION_MODEL_ID=
TRACE_LLM_CONVERSATIONAL_MODEL_ID=
# A variable NAME only, never the credential itself. No credentials are loaded in Phase 3.1.
TRACE_LLM_CREDENTIAL_ENV_VAR=
# Defaults allow no paid usage. One micro-USD is one millionth of a US dollar.
TRACE_LLM_SPEND_LIMIT_MICROUSD=0
TRACE_LLM_MAX_COST_PER_ATTEMPT_MICROUSD=0
