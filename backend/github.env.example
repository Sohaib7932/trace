# Documentation template only; not automatically loaded. Never commit real values.
# Configure these in the backend PROCESS or deployment secret manager, not the
# strict general backend/.env and never root .env.local / NEXT_PUBLIC_*.
TRACE_GITHUB_APP_MODE=disabled
TRACE_GITHUB_APP_ID=<numeric-app-id>
TRACE_GITHUB_APP_SLUG=<github-app-slug>
TRACE_GITHUB_APP_CLIENT_ID=<github-app-client-id>
TRACE_GITHUB_APP_CLIENT_SECRET=<configure-privately>
TRACE_GITHUB_APP_PRIVATE_KEY=<configure-rsa-pem-privately>
TRACE_GITHUB_APP_STATE_SIGNING_SECRET=<independent-random-secret-at-least-32-characters>
TRACE_GITHUB_APP_TOKEN_ENCRYPTION_KEY=<independent-fernet-key-configure-privately>
# The encryption key is URL-safe base64 encoding of 32 random bytes. Keep it
# stable and backed up privately; rotation makes old credentials require reconnect.
# It is separate from the OAuth client secret and state-signing secret.
TRACE_GITHUB_APP_CALLBACK_URL=http://localhost:3000/projects/github/callback
