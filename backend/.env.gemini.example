# Backend-only credential template. From the repository root, copy
# backend/.env.gemini.example to backend/.env.gemini and fill privately.
# If your terminal is already inside backend, the destination is .env.gemini
# (do not create another nested backend directory).
# The actual .env.gemini is ignored by Git. Never add this key to frontend variables.
# This file alone does not activate live AI; use the explicit free-tier startup script.
GEMINI_API_KEY=
