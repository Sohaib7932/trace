# Backend only. Relative SQLite paths resolve from backend/, independent of shell cwd.
TRACE_ENVIRONMENT=development
TRACE_DATABASE_URL=sqlite+pysqlite:///./trace.db
TRACE_DATABASE_TIMEOUT_SECONDS=3
TRACE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRACE_LOG_LEVEL=INFO
TRACE_REQUEST_TIMEOUT_SECONDS=30
TRACE_MAX_REQUEST_BYTES=65536
# Legacy reserved hint guidance remains deterministic. Gemini tutor/support use
# the separate approved launcher and TRACE_LLM_* process configuration.
TRACE_AI_PROVIDER=fake
# Explicit local HTTP mode. HTTPS deployments must use Secure cookies.
TRACE_COOKIE_SECURE=false
TRACE_ALLOW_INSECURE_LOCAL_COOKIES=true
TRACE_CREDENTIAL_LIFETIME_SECONDS=2592000
TRACE_VERIFICATION_TIMEOUT_SECONDS=10
# Gemini credentials belong in backend/.env.gemini, not this strict settings file.
# Do not add TRACE_LLM_* variables here. Never use NEXT_PUBLIC_* for provider keys.
# Optional Supabase Auth only. Set all three from the same project, or leave all blank.
TRACE_SUPABASE_URL=
TRACE_SUPABASE_ISSUER=
TRACE_SUPABASE_JWKS_URL=
TRACE_SUPABASE_AUDIENCE=authenticated
TRACE_AUTH_JWKS_CACHE_SECONDS=300
# Only for an explicitly selected loopback test Auth server; hosted Supabase uses HTTPS.
TRACE_AUTH_ALLOW_INSECURE_LOOPBACK=false
