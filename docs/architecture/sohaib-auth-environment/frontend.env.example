# Shareable Module 4 template for Sohaib. Contains no copied local credentials.
# Destination: <your Trace checkout>/.env.local
# Copy only if the destination is absent; otherwise merge the settings deliberately.

# MACHINE-SPECIFIC: these defaults assume local frontend 3000 and API 8000.
# Open http://localhost:3000 and keep browser/API hostnames identical.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SHARED PROJECT: obtain both values from the team's existing Supabase project.
# Leave blank until supplied; do not use the automated-test fixture configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The publishable key is public client configuration and must use the supported
# sb_publishable_ format. No service-role/secret key, password or Google secret here.
