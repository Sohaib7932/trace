# Shareable Module 4 template for Sohaib. Contains no copied local credentials.
# Destination: <your Trace checkout>/backend/.env
# Copy only if absent; otherwise merge, preserving that machine's existing settings.

# MACHINE-SPECIFIC: local development with SQLite in this checkout's backend folder.
TRACE_ENVIRONMENT=development
TRACE_DATABASE_URL=sqlite+pysqlite:///./trace.db
TRACE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Local HTTP only. Public HTTPS environments require Secure cookies.
TRACE_COOKIE_SECURE=false
TRACE_ALLOW_INSECURE_LOCAL_COOKIES=true

# SHARED PROJECT: the same HTTPS project URL as NEXT_PUBLIC_SUPABASE_URL.
# Set all three together. Obtain the project URL, then derive the exact endpoints:
# issuer = project URL without trailing slash + /auth/v1
# JWKS   = issuer + /.well-known/jwks.json
TRACE_SUPABASE_URL=
TRACE_SUPABASE_ISSUER=
TRACE_SUPABASE_JWKS_URL=

# APPLICATION DEFAULTS: safe explicit defaults, not credentials to request.
TRACE_SUPABASE_AUDIENCE=authenticated
TRACE_AUTH_JWKS_CACHE_SECONDS=300
# Hosted shared Supabase uses HTTPS. Keep this false; not the local test Auth server.
TRACE_AUTH_ALLOW_INSECURE_LOOPBACK=false
TRACE_DATABASE_TIMEOUT_SECONDS=3
TRACE_LOG_LEVEL=INFO
TRACE_REQUEST_TIMEOUT_SECONDS=30
TRACE_MAX_REQUEST_BYTES=65536
TRACE_AI_PROVIDER=fake
TRACE_CREDENTIAL_LIFETIME_SECONDS=2592000
TRACE_VERIFICATION_TIMEOUT_SECONDS=10

# No Supabase service-role key, signing secret, Google secret or SMTP password needed.
