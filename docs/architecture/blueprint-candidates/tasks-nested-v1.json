{
  "spec_version": "1.0.0",
  "lesson_id": "fastapi-nested-payload-transfer",
  "version_id": "23262bf1-335b-53c5-904f-c0868f0be236",
  "version": "1.1.0",
  "entry_mode": "transfer_only",
  "title": "Trace the nested task contract",
  "summary": "Transfer request-contract reasoning to a nested FastAPI payload.",
  "objectives": [
    {
      "id": "trace-nesting",
      "statement": "Trace a value's JSON nesting into the receiving model and verify a committed task.",
      "evidence_checkpoint_ids": [
        "predict-request",
        "investigate-contract",
        "modify-request",
        "verify-save"
      ]
    }
  ],
  "scenario": {
    "context": "A task request contains a title and priority but no task is saved. Inspect the JSON levels and nested receiver before selecting a mapping change.",
    "input_values": {
      "title": "Prepare the product demo",
      "priority": "high"
    },
    "initial_state_description": "This isolated verification run begins without stored exercise rows.",
    "artifacts": [
      {
        "id": "request-builder",
        "label": "The unchanged outgoing request",
        "language": "python",
        "content": "payload = {\n    \"title\": task.title,\n    \"priority\": task.priority,\n}\nresponse = client.post(\"/tasks\", json=payload)"
      },
      {
        "id": "receiver-schema",
        "label": "The actual receiving model contract",
        "language": "python",
        "content": "from typing import Literal\nfrom pydantic import BaseModel, ConfigDict, Field\n\nclass TaskMetadata(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n    priority: Literal[\"low\", \"normal\", \"high\"]\n\nclass TaskCreate(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n    title: str = Field(min_length=1, max_length=200)\n    metadata: TaskMetadata"
      }
    ]
  },
  "checkpoints": [
    {
      "id": "predict-request",
      "title": "Predict the unchanged request",
      "prompt": "Predict the outcome of the shown request before changing its mapping.",
      "objective_ids": [
        "trace-nesting"
      ],
      "depends_on": [],
      "hint_ids": [],
      "evaluation_rule_id": "rule-prediction",
      "type": "prediction",
      "choices": [
        {
          "id": "rejected",
          "label": "The receiving contract rejects the request."
        },
        {
          "id": "saved",
          "label": "The request saves a row successfully."
        },
        {
          "id": "server_error",
          "label": "The service has an infrastructure failure."
        }
      ],
      "reasoning_required": true
    },
    {
      "id": "investigate-contract",
      "title": "Trace the receiving contract",
      "prompt": "Compare the sender and receiver with the observed initial validation evidence. Identify the outgoing field and its required receiving location.",
      "objective_ids": [
        "trace-nesting"
      ],
      "depends_on": [
        "predict-request"
      ],
      "hint_ids": [
        "hint-orient",
        "hint-compare",
        "hint-evidence"
      ],
      "evaluation_rule_id": "rule-investigation",
      "type": "investigation",
      "artifact_ids": [
        "request-builder",
        "receiver-schema"
      ],
      "baseline_profile_id": "initial_failure",
      "baseline_evidence_artifact_id": "observed-initial-validation"
    },
    {
      "id": "modify-request",
      "title": "Choose a request mapping",
      "prompt": "Choose the bounded mapping change you want Trace to verify.",
      "objective_ids": [
        "trace-nesting"
      ],
      "depends_on": [
        "investigate-contract"
      ],
      "hint_ids": [
        "hint-orient",
        "hint-compare",
        "hint-evidence"
      ],
      "evaluation_rule_id": "rule-modification",
      "type": "modification",
      "change_type": "nest_payload_field",
      "choices": [
        {
          "id": "flat",
          "label": "Keep the original request mapping."
        },
        {
          "id": "nested",
          "label": "Match the receiving contract's field location."
        }
      ],
      "explanation_required": false
    },
    {
      "id": "verify-save",
      "title": "Verify the committed result",
      "prompt": "Use the observed HTTP response, validation and independent database readback to assess the mapping.",
      "objective_ids": [
        "trace-nesting"
      ],
      "depends_on": [
        "modify-request"
      ],
      "hint_ids": [
        "hint-orient",
        "hint-compare",
        "hint-evidence"
      ],
      "evaluation_rule_id": "rule-verification",
      "type": "verification",
      "modification_checkpoint_id": "modify-request",
      "profile_id": "repair"
    }
  ],
  "hints": [
    {
      "id": "hint-orient",
      "level": 1,
      "text": "Trace the request data from its sender into its receiving model.",
      "checkpoint_ids": [
        "investigate-contract",
        "modify-request",
        "verify-save"
      ]
    },
    {
      "id": "hint-compare",
      "level": 2,
      "text": "Compare each outgoing field location with the required receiving location.",
      "checkpoint_ids": [
        "investigate-contract",
        "modify-request",
        "verify-save"
      ]
    },
    {
      "id": "hint-evidence",
      "level": 3,
      "text": "Use the missing and extra validation fields before investigating database code.",
      "checkpoint_ids": [
        "investigate-contract",
        "modify-request",
        "verify-save"
      ]
    }
  ],
  "explanations": [
    {
      "id": "explain-core",
      "title": "What the runtime evidence establishes",
      "text": "The receiver requires metadata containing priority and forbids a flat priority field. The unchanged request produces HTTP 422 with missing metadata and extra priority validation errors, and saves no task. A nested mapping succeeds only when HTTP 201, the response metadata and one independently read task agree, including row identity.",
      "checkpoint_id": "verify-save",
      "release_event": "core_verification_passed"
    }
  ],
  "misconceptions": [
    {
      "id": "presence-implies-validity",
      "statement": "Containing the intended value alone means a request satisfies its contract.",
      "indicator": {
        "kind": "mapping_selected",
        "checkpoint_id": "modify-request",
        "value": "flat"
      },
      "suggested_feedback": "Compare both the value and its receiving field location; presence alone is insufficient."
    }
  ],
  "completion_policy": {
    "core_checkpoint_ids": [
      "predict-request",
      "investigate-contract",
      "modify-request",
      "verify-save"
    ],
    "transfer_checkpoint_ids": [],
    "retrieval_checkpoint_ids": []
  },
  "tutor_policy": {
    "mode": "authored_only",
    "max_requests_per_core_session": 3,
    "available_after_checkpoint_id": "predict-request"
  },
  "private": {
    "runtime_binding": {
      "template_id": "tasks-nested-v1",
      "revision": "1.0.0"
    },
    "evaluation": {
      "policy_id": "payload-contract-v1",
      "revision": "1.0.0",
      "rules": {
        "rule-investigation": {
          "kind": "field_trace",
          "expected_outgoing_field": "priority",
          "expected_required_path": "/metadata/priority",
          "required_artifact_ids": [
            "request-builder",
            "receiver-schema",
            "observed-initial-validation"
          ]
        },
        "rule-modification": {
          "kind": "allowed_mapping",
          "allowed_values": [
            "flat",
            "nested"
          ],
          "correct_value": "nested"
        },
        "rule-prediction": {
          "kind": "outcome_diagnostic",
          "answer": "rejected",
          "gate": "valid_submission"
        },
        "rule-verification": {
          "kind": "verified_repair"
        }
      }
    },
    "verification": {
      "timeout_seconds": 10,
      "fixture": {
        "id": "empty-tasks-v1",
        "input_values": {
          "title": "Prepare the product demo",
          "priority": "high"
        },
        "initial_mapping": "flat"
      },
      "profiles": {
        "initial_failure": {
          "purpose": "baseline",
          "http_status": 422,
          "response_shape": "validation_errors",
          "validation_codes": [
            "missing:metadata",
            "extra_forbidden:priority"
          ],
          "row_count": 0,
          "stored_values": {},
          "require_response_row_identity_match": false,
          "required_checks": [
            "http_status",
            "api_response",
            "validation",
            "row_count",
            "stored_values"
          ]
        },
        "repair": {
          "purpose": "repair",
          "http_status": 201,
          "response_shape": "saved_task",
          "validation_codes": [],
          "row_count": 1,
          "stored_values": {
            "title": "Prepare the product demo",
            "priority": "high"
          },
          "require_response_row_identity_match": true,
          "required_checks": [
            "http_status",
            "api_response",
            "validation",
            "row_count",
            "stored_values"
          ]
        }
      }
    }
  },
  "content_sha256": "4b47587a9781e5ed855c4ba08245090de095b187f6d83f2565f938bcb0b2348b"
}
