              "zone": "east"
            },
            "schema_code": "class Destination(BaseModel):\n    zone: str\n\nclass ShipmentCreate(BaseModel):\n    reference: str\n    destination: Destination",
            "options": [
              {
                "id": "a",
                "label": "Any request containing zone must be accepted."
              },
