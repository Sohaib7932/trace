      "explanations": [
        {
          "id": "core-explanation",
          "title": "Why this correction works",
          "text": "The receiver requires content, while the unchanged sender supplies body. Correcting the mapping satisfies the contract. A successful status alone is insufficient: the independent read must find the same committed note and values.",
          "checkpoint_id": "verify-note",
          "release_event": "core_verification_passed"
        },
        {
          "id": "retrieval-1-explanation",
          "title": "Read the receiving shape",
          "text": "The contract expects destination.zone. A flat zone cannot supply the required destination object.",
          "checkpoint_id": "revisit-day-1",
          "release_event": "retrieval_response_saved"
        },
        {
          "id": "retrieval-2-explanation",
          "title": "Read the receiving shape",
          "text": "The contract expects output.format while name remains at the root. Renaming or stringifying does not create that object.",
          "checkpoint_id": "revisit-day-7",
          "release_event": "retrieval_response_saved"
        }
      ],
      "misconceptions": [
        {
          "id": "presence-implies-validity",
          "statement": "Any submitted value must satisfy the receiving model.",
          "indicator": {
