            "id": "report-contract-v1",
            "title": "Recall the report mapping",
            "prompt": "A report form provides name and format. Which change retains the information and satisfies this receiving model?",
            "payload": {
              "name": "Weekly digest",
              "format": "csv"
            },
            "schema_code": "class Output(BaseModel):\n    format: Literal[\"csv\", \"json\"]\n\nclass ReportCreate(BaseModel):\n    name: str\n    output: Output",
            "options": [
              {
                "id": "a",
                "label": "Place format inside an output object and retain name at the root."
              },
              {
                "id": "b",
                "label": "Rename format to body and retain it at the root."
              },
