# Optional. If unset, the API client uses the browser hostname on port 8000.
# Use matching hostnames in browser and API URLs for SameSite cookies.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Never put ownership credentials or AI keys here.
# Optional accounts: fill these from your own Supabase project; leave blank for guest-only use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pin the app origin for callbacks; match the hostname you open in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
