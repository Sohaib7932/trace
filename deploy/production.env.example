# Names/placeholders only. Supply private values through the approved host secret manager.
# Do not copy a developer database or private environment file into the container.
TRACE_ENVIRONMENT=production
TRACE_DATABASE_URL=postgresql+psycopg://RUNTIME_ROLE:PRIVATE_PASSWORD@DATABASE_HOST/TRACE_DATABASE?sslmode=verify-full
TRACE_DATABASE_SCHEMA=trace
TRACE_DATABASE_POOL_SIZE=4
TRACE_DATABASE_MAX_OVERFLOW=0
TRACE_DATABASE_POOL_TIMEOUT_SECONDS=3
TRACE_DATABASE_POOL_RECYCLE_SECONDS=300
TRACE_DATABASE_TIMEOUT_SECONDS=3
TRACE_DATABASE_STATEMENT_TIMEOUT_SECONDS=5
TRACE_DATABASE_LOCK_TIMEOUT_SECONDS=3
TRACE_CORS_ORIGINS=["https://FRONTEND_HOST"]
# Explicit trusted edge peer IPs/CIDRs, comma separated. Never '*', /0 or auto-detected headers.
TRACE_TRUSTED_PROXY_IPS=PROXY_PRIVATE_IP_OR_CIDR
# Optional Render-only original-scheme handling; disabled by default.
# Activation requires review of the public edge AND all private-network callers.
# These settings NEVER expand TRACE_TRUSTED_PROXY_IPS or client-IP trust.
TRACE_RENDER_EDGE_MODE=disabled
# TRACE_RENDER_EDGE_MODE=enabled
# TRACE_RENDER_EDGE_HOSTNAME=EXACT_SERVICE.onrender.com
# TRACE_RENDER_EDGE_TRUSTED_PRIVATE_PERIMETER_CONFIRMED=true
TRACE_COOKIE_SECURE=true
TRACE_ALLOW_INSECURE_LOCAL_COOKIES=false
TRACE_AUTH_ALLOW_INSECURE_LOOPBACK=false
TRACE_LOG_LEVEL=INFO
TRACE_SUPABASE_URL=https://PROJECT.supabase.co
TRACE_SUPABASE_ISSUER=https://PROJECT.supabase.co/auth/v1
TRACE_SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
TRACE_SUPABASE_AUDIENCE=authenticated
# Disabled is safe. Live activation also needs the approved zero-budget profile,
# server-only GEMINI_API_KEY and durable allowance scope configured separately.
TRACE_LLM_MODE=disabled
TRACE_EMBEDDING_MODE=disabled
TRACE_RETRIEVAL_MODE=lexical
# Required in every production profile, including disabled AI, for shared admission.
# This is a stable cumulative operator allowance, never an automatic daily reset.
TRACE_ACCOUNTING_MODE=durable
TRACE_ACCOUNTING_SCOPE=REPLACE_WITH_SHORT_STABLE_OPERATOR_SCOPE
TRACE_ACCOUNTING_MAX_ATTEMPTS=20
TRACE_ACCOUNTING_MAX_IN_FLIGHT=4
TRACE_ACCOUNTING_MAX_SUBJECT_IN_FLIGHT=1
TRACE_ACCOUNTING_REQUESTS_PER_MINUTE=10
